        "additionalProperties": true,
        "description": "Common Futrou API resource fields.",
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "displayName": {
            "description": "Human-readable resource name.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
