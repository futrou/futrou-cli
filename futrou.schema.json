          },
          "id": {
            "description": "Futrou resource identifier.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "description": "Resource name.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "projectId": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "public": {
            "type": "boolean"
          },
          "regionId": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "storagePlanId": {
