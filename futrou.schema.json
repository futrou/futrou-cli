          "preserveHeaders": {
            "type": "boolean"
          },
          "preserveHost": {
            "type": "boolean"
          },
          "preservePath": {
            "type": "boolean"
          },
          "preserveQuery": {
            "type": "boolean"
          },
          "projectId": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "proxyPlanId": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "regionId": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "rules": {},
          "status": {
            "type": "string"
          },
          "strategy": {
            "enum": [
              "round-robin",
              "primary-failover"
            ],
            "type": "string"
          },
          "target": {
            "minLength": 1,
            "type": "string"
          },
          "type": {
            "enum": [
              "http",
              "tcp",
              "udp"
            ],
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "verifyTls": {
            "type": "boolean"
          },
          "workspaceId": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
