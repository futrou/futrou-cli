            "type": "boolean"
          },
          "followRedirects": {
            "type": "boolean"
          },
          "id": {
            "description": "Futrou resource identifier.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "isVerified": {
            "type": "boolean"
          },
          "name": {
            "description": "Resource name.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
