            "description": "Plan ID that determines serverlet sizing.",
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "workspaceId": {
            "maxLength": 255,
            "minLength": 1,
            "type": "string"
          }
        },
        "type": "object"
